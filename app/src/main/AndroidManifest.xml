<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".LifeBoardApp"
        android:allowBackup="true"
        android:icon="@drawable/screenshot_2026_11_26_at_08_45_50"
        android:label="@string/app_name"
        android:roundIcon="@drawable/screenshot_2026_11_26_at_08_45_50"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeBoardApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <receiver
            android:name=".widget.LifeBoardWidgetReceiver"
            android:exported="true">

            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lifeboard_widget_info" />
        </receiver>

    </application>

</manifest>
