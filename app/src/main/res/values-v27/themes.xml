<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LifeBoardApp" parent="android:style/Theme.Material.Light.NoActionBar">

        <!-- Font -->
        <item name="android:fontFamily">sans</item>

        <!-- Primary accent -->
        <item name="android:colorAccent">#8B7CC8</item>

        <!-- Window backgrounds -->
        <item name="android:windowBackground">#F8F7FC</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- System bars -->
        <item name="android:statusBarColor">#F8F7FC</item>
        <item name="android:navigationBarColor">#F8F7FC</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Text -->
        <item name="android:textColorPrimary">#292638</item>
        <item name="android:textColorSecondary">#777387</item>

        <!-- Controls -->
        <item name="android:colorControlActivated">#8B7CC8</item>
        <item name="android:colorControlHighlight">#338B7CC8</item>

        <!-- Input fields -->
        <item name="android:colorControlNormal">#B9B4C9</item>

    </style>
</resources>